rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidFile(data) {
      return data.id is string 
        && data.userId is string 
        && data.name is string && data.name.size() <= 256
        && data.type in ['part', 'chapter']
        && data.order is number
        && (data.parentId == null || data.parentId is string)
        && (data.content == null || data.content is string);
    }

    // Collections
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      match /files/{fileId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFile(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidFile(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
